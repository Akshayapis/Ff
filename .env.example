# ---- required ----
DATABASE_URL=postgresql://user:password@host:5432/dbname
# Long random string (>= 32 chars). If omitted, one is generated and stored in the DB.
JWT_SECRET=change-me-to-a-long-random-string
# First admin account (created only when no admin exists). CHANGE the password after first login.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeMe@123
# Public https URL of your site (used for payment redirect + webhook). Can also be set in Admin > Settings.
PUBLIC_URL=https://your-app.onrender.com

# ---- optional: fallbacks if not set from Admin > Settings ----
OTP_API_BASE=https://otp-lio.onrender.com
OTP_API_KEY=
PAY_API_BASE=https://v3payamunt.vercel.app/api/v1
PAY_USERNAME=
PAY_KEY=
